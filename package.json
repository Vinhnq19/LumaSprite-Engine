{
  "name": "lumasprite-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/cli-smoke.ts",
    "generate": "node dist/cli/main.js",
    "benchmark": "node dist/cli/benchmark.js",
    "benchmark:e2": "node scripts/benchmark-e2.ts",
    "benchmark:e23": "node scripts/benchmark-e2.ts --e23",
    "benchmark:e24": "node scripts/benchmark-e24.ts",
    "terrain": "node dist/cli/terrain.js",
    "benchmark:e3": "node scripts/benchmark-e3.ts",
    "benchmark:e32": "node scripts/benchmark-e32.ts",
    "benchmark:e33": "node scripts/benchmark-e33.ts",
    "report:e33": "node scripts/report-e33.ts",
    "benchmark:e34": "node scripts/benchmark-e34.ts",
    "report:e34": "node scripts/report-e34.ts",
    "test:terrain-production-studio": "node --test scripts/terrain-production-studio.ts",
    "report:e32": "node scripts/report-e32.ts",
    "report:e3": "node scripts/report-e3.ts",
    "test:terrain-studio": "node --test scripts/terrain-studio.ts",
    "serve": "node dist/server/main.js",
    "test:studio": "node --test scripts/studio-preview.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
